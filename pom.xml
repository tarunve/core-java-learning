<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <modules>
        <module>java-basics-001-core-concepts</module>
        <module>java-basics-002-design-patterns</module>
        <module>java-basics-003-reactive</module>
        <module>java-basics-004-junit-mockito</module>
        <module>java-basics-005-enhancements-07</module>
        <module>java-basics-005-enhancements-08</module>
        <module>java-basics-005-enhancements-09</module>
        <module>java-basics-005-enhancements-10</module>
        <module>java-basics-005-enhancements-11</module>
        <module>java-basics-005-enhancements-12</module>
        <module>java-basics-005-enhancements-14</module>
        <module>java-basics-005-enhancements-15</module>
        <module>java-basics-005-enhancements-16</module>
        <module>java-basics-005-enhancements-17</module>
    </modules>

    <groupId>com.learning</groupId>
    <artifactId>core-java-learning</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>26</maven.compiler.source>
        <maven.compiler.target>26</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>


    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.48</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>